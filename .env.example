# RAMAYAML YOUTH Google Drive Photo Uploader - Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Google Drive Destination Folder ID (Required for Google Drive destination)
# Extract from folder URL: https://drive.google.com/drive/folders/YOUR_FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID=1a2b3c4d5e6f7g8h9i0j_example_folder_id

# Option 1: Google OAuth 2.0 Credentials (Recommended for personal Google Drive)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_REFRESH_TOKEN=1//04your_refresh_token_here
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground

# Option 2: Google Service Account Credentials (Alternative for Google Workspace)
GOOGLE_SERVICE_ACCOUNT_EMAIL=ramayaml-youth-uploader@your-project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RSA_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
